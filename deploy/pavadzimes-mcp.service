[Unit]
Description=SIA Bratus pavadzīmes — MCP serveris priekš Claude
After=network-online.target

[Service]
User=pavadzimes
WorkingDirectory=/opt/pavadzimes/app
Environment=PAVADZ_DATA_DIR=/opt/pavadzimes/data
Environment=PAVADZ_MCP_PORT=8787
Environment=PAVADZ_PUBLIC_URL=https://noliktavas-thinkpad.tailbfb842.ts.net:8787
Environment=PAVADZ_ALLOWED_HOSTS=noliktavas-thinkpad.tailbfb842.ts.net,noliktavas-thinkpad.tailbfb842.ts.net:8787
ExecStart=/opt/pavadzimes/.venv/bin/python mcp_server.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
